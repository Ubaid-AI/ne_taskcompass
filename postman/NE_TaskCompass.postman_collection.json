    {
      "name": "Tenders / Pipeline / Performance",
      "item": [
        { "name": "List tenders", "request": { "method": "POST", "url": "{{base_url}}/api/method/ne_taskcompass.api.tenders.list_tenders", "description": "Stages are Identified, Submitted, Won, Lost, Closed. Each row includes po_number, po_date, and supporting_file_url. Tender amount is not returned." } },
        { "name": "Get tender", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"TC-TND-00001\"\n}" }, "url": "{{base_url}}/api/method/ne_taskcompass.api.tenders.get_tender", "description": "Full tender, including supporting_file_url for the PO or challan. Amount is not returned." } },
        { "name": "Save tender", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"title\": \"PIMS haemostat tender\",\n  \"hospital\": \"Pakistan Institute of Medical Sciences (PIMS)\",\n  \"stage\": \"Identified\",\n  \"po_number\": \"PO-2026-0142\",\n  \"po_date\": \"2026-10-11\",\n  \"supporting_document\": \"/private/files/po.jpg\",\n  \"items\": [{ \"product\": \"Stypcel\", \"qty\": 200 }]\n}" }, "url": "{{base_url}}/api/method/ne_taskcompass.api.tenders.save_tender", "description": "Any logged-in TaskCompass role (including TC Salesperson) can create or update. po_number and po_date are required. stage is Identified, Submitted, Won, Lost, or Closed. A Won tender stays open until someone sets Closed after the order is finished. supporting_document is the file URL from /api/method/upload_file (doctype TC Tender, fieldname supporting_document). Omit items on an update to leave product lines unchanged. Do not send an amount." } },
        { "name": "Update tender", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"TC-TND-00001\",\n  \"title\": \"PIMS haemostat tender\",\n  \"stage\": \"Won\",\n  \"po_number\": \"PO-2026-0142\",\n  \"po_date\": \"2026-10-11\",\n  \"notes\": \"Order received. Close manually when the order is finished.\"\n}" }, "url": "{{base_url}}/api/method/ne_taskcompass.api.tenders.save_tender", "description": "Same method as Save tender. Pass name. po_number and po_date stay required. Salespersons may update tenders they lead. Set stage to Closed only when the order is finished." } },
        { "name": "Tender supporting document", "request": { "method": "GET", "url": "{{base_url}}/api/method/ne_taskcompass.api.tenders.tender_file?name=TC-TND-00001", "description": "Returns the PO or challan file for anyone who can read that tender. Use this instead of /private/files/..." } },
        { "name": "Pipeline", "request": { "method": "POST", "url": "{{base_url}}/api/method/ne_taskcompass.api.pipeline.get_pipeline" } },
        { "name": "Team scores", "request": { "method": "POST", "url": "{{base_url}}/api/method/ne_taskcompass.api.performance.team_scores" } },
        { "name": "Overview KPIs", "request": { "method": "POST", "url": "{{base_url}}/api/method/ne_taskcompass.api.performance.overview" } },
        { "name": "Add performance event", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"salesperson\": \"Mr. Shoaib\",\n  \"kind\": \"missed_visit\",\n  \"points\": -5,\n  \"note\": \"Did not complete day plan\"\n}" }, "url": "{{base_url}}/api/method/ne_taskcompass.api.performance.add_event" } }
      ]
